{
  "name": "ez-php/log-transport",
  "version": "2.3.7",
  "description": "Async/remote log shipping (ELK, Datadog, Loki) drivers for ez-php/logging",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["log-transport", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/log-transport",
  "support": {
    "issues": "https://github.com/ez-php/log-transport/issues",
    "source": "https://github.com/ez-php/log-transport"
  },
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "ez-php/logging": "^2.3"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\LogTransport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
